# Jangan isi manual. Jalankan: python -m scripts.init_env
# Semua kunci = 32 byte acak, base64.
MASTER_KEY=          # KEK: membungkus (wrap) kunci per-item
INTEGRITY_KEY=       # HMAC plaintext untuk cek keutuhan end-to-end
BLIND_INDEX_KEY=     # HMAC email untuk login tanpa menyimpan email asli
JWT_SECRET=
JWT_EXP_MINUTES=120
DB_PATH=data/lapor.db
STORAGE_DIR=storage
MAX_UPLOAD_MB=200
CORS_ORIGINS=http://localhost:5173
